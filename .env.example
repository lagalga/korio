# Hetzner / VPS
VPS_IP=your_vps_ip_here

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434

# Postgres local (docker)
POSTGRES_USER=korio
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=korio

# Supabase (completar cuando crees cuenta)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# FalkorDB (local)
FALKORDB_PORT=6379
FALKORDB_URL=redis://localhost:6379

# JWT
JWT_SECRET=your_jwt_secret_here

# Mistral API (opcional, fallback)
MISTRAL_API_KEY=api_key_de_mistral

# Observabilidad — LangSmith (sesión 18)
# Activar trazas distribuidas del pipeline RAG. Si LANGCHAIN_TRACING_V2 != true
# todo el instrumentado degrada a no-op (src/observability.py).
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=ls__your_langsmith_key_here
LANGCHAIN_PROJECT=korio
# Región del workspace LangSmith. Si tu cuenta es UE (registro en eu.smith.langchain.com)
# DEBES fijar el endpoint EU o el ingest devuelve 403 Forbidden contra el endpoint US
# por defecto. Bonus GDPR: trazas (inputs/outputs RAG con posible PII) residentes en UE.
LANGCHAIN_ENDPOINT=https://eu.api.smith.langchain.com

# Observabilidad OTel → Jaeger (sesión 18)
# Activar trazas HTTP (FastAPI + requests) exportadas a Jaeger vía OTLP.
# No-op si KORIO_OTEL_ENABLED != 1 (api/otel.py). Jaeger UI: 127.0.0.1:16686.
KORIO_OTEL_ENABLED=0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=korio-api
